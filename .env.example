# Copier ce fichier en .env et renseigner les valeurs. Ne jamais committer le .env réel.

# --- PostgreSQL ---
POSTGRES_DB=csv_analyzer
POSTGRES_USER=csv_analyzer
POSTGRES_PASSWORD=change-me
# Utilisé seulement hors docker-compose (en compose, POSTGRES_HOST=postgres est fixé automatiquement)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Redis ---
# Utilisé seulement hors docker-compose (en compose, REDIS_URL est fixé automatiquement)
REDIS_URL=redis://localhost:6379/0

# --- Stockage des fichiers : local (dev) ou s3 (prod) ---
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=/data/uploads

# Renseigner uniquement si STORAGE_BACKEND=s3
S3_BUCKET=
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-1

# --- Divers ---
MAX_UPLOAD_SIZE_MB=200
LOG_LEVEL=INFO
